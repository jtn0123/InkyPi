# InkyPi dev/CI dependencies — loose constraints for universal uv compilation.
# Edit this file to add/upgrade dependencies, then regenerate:
#   uv --no-config pip compile --universal --python-version 3.13 --fork-strategy fewest \
#     --prerelease disallow --generate-hashes install/requirements-dev.in \
#     -o install/requirements-dev.txt
#
# Use uv for committed lockfiles so platform/interpreter markers are preserved.

# Core dev tooling
uv==0.13.4

