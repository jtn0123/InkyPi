#!/usr/bin/env bash
set -e

# PROJECT_DIR, VENV_PATH and APPNAME come from the `inkypi` wrapper.
: "${PROJECT_DIR:?PROJECT_DIR is not set; run this through the inkypi command}"

PLUGINS_DIR="$PROJECT_DIR/src/plugins"

# A plugin id is a folder name under src/plugins. The same pattern as "id" in
# src/config/schemas/plugin-info.schema.json, so it can't be empty, "..", or a
# path.
PLUGIN_ID_PATTERN='^[a-z0-9_]+$'

command="${1:-}"
shift || true

usage() {
    echo ""
    echo "Plugin commands:"
    echo "  inkypi plugin install <plugin_id> <git_repository_url>"
    echo "  inkypi plugin uninstall <plugin_id>"
    echo "  inkypi plugin list"
    echo ""
}

require_plugins_dir() {
    if [[ ! -d "$PLUGINS_DIR" ]]; then
        echo "Plugins directory does not exist: $PLUGINS_DIR"
        exit 1
    fi
}

require_valid_plugin_id() {
    if [[ ! "$1" =~ $PLUGIN_ID_PATTERN ]]; then
        echo "[ERROR] Invalid plugin id '$1': use only lowercase letters, digits and underscores."
        exit 1
    fi
}

# The git checkout behind the install. $PROJECT_DIR/src is a link to the
# checkout's src/ (install.sh), and the checkout holds install/requirements.txt.
repo_dir() {
    local src
    src=$(realpath "$PROJECT_DIR/src") || return 1
    dirname "$src"
}

# Built-in plugins are tracked by git in the checkout. A third-party plugin is
# its own clone, untracked beside them. plugin-info.json's "repository" key
# can't tell the two apart: it is optional for third-party plugins
# (docs/building_plugins.md). Run with sudo, git is root on a checkout the
# user owns, so the safe.directory override is needed (CVE-2022-24765).
require_not_builtin() {
    local plugin_id="$1" repo tracked
    if ! repo=$(repo_dir) ||
        ! tracked=$(git -c safe.directory="$repo" -C "$repo" ls-files -- "src/plugins/$plugin_id"); then
        echo "[ERROR] Could not check with git whether '$plugin_id' is a built-in plugin; refusing to change it."
        exit 1
    fi
    if [[ -n "$tracked" ]]; then
        echo "[ERROR] '$plugin_id' is a built-in plugin. Built-in plugins come with InkyPi and can't be replaced or removed."
        exit 1
    fi
}

# rm -rf a plugin's folder, but only after resolving links and ".." shows it
# really is $PLUGINS_DIR/<plugin_id>.
remove_plugin_dir() {
    local plugin_id="$1" plugins_real target_real
    local target="$PLUGINS_DIR/$plugin_id"
    if [[ ! -e "$target" && ! -L "$target" ]]; then
        return 0
    fi
    if ! plugins_real=$(realpath "$PLUGINS_DIR") || ! target_real=$(realpath "$target"); then
        echo "[ERROR] Could not resolve $target; refusing to delete it."
        exit 1
    fi
    if [[ "$target_real" != "$plugins_real/$plugin_id" ]]; then
        echo "[ERROR] Refusing to delete $target: it resolves to $target_real, which is not a plugin folder in $plugins_real."
        exit 1
    fi
    rm -rf -- "$target_real"
}

# Install the plugin's requirements.txt into the app's venv without moving any
# package InkyPi is locked to.
install_plugin_requirements() {
    local plugin_id="$1" req_file="$2" repo lock_file constraints

    if [[ ! -x "$VENV_PATH/bin/python" ]]; then
        echo "[ERROR] Virtual environment not found at $VENV_PATH"
        remove_plugin_dir "$plugin_id"
        exit 1
    fi

    repo=$(repo_dir) || true
    lock_file="$repo/install/requirements.txt"
    if [[ -z "$repo" || ! -f "$lock_file" ]]; then
        echo "[ERROR] InkyPi's lock file was not found at $lock_file, so the plugin's requirements can't be checked against it."
        remove_plugin_dir "$plugin_id"
        exit 1
    fi

    # The lock pins every package with hashes. Passed to pip as-is, those
    # hashes switch on --require-hashes for the whole install, which rejects
    # any plugin requirement that isn't itself pinned and hashed. Keep the
    # "name==version ; marker" lines only.
    constraints=$(mktemp)
    # Expanded now on purpose: $constraints is local to this function.
    # shellcheck disable=SC2064
    trap "rm -f '$constraints'" EXIT
    grep -E '^[A-Za-z0-9]' "$lock_file" | sed -E 's/[[:space:]]*\\$//' >"$constraints"

    echo "[WARN] Plugin packages are not hash-checked: pip installs whatever versions the package index serves."
    echo "[INFO] Packages InkyPi itself uses are held to the versions in $lock_file."

    if ! "$VENV_PATH/bin/python" -m pip install --constraint "$constraints" -r "$req_file"; then
        echo "[ERROR] The plugin's requirements could not be installed alongside InkyPi's locked packages (see pip's output above)."
        echo "[ERROR] No locked package was changed. Removing plugin '$plugin_id'."
        remove_plugin_dir "$plugin_id"
        exit 1
    fi
}

# ----------------------------
# INSTALL
# ----------------------------
install_plugin() {
    if [[ $# -ne 2 ]]; then
        usage
        exit 1
    fi

    PLUGIN_ID="$1"
    REPO_URL="$2"
    require_valid_plugin_id "$PLUGIN_ID"
    DEST_DIR="$PLUGINS_DIR/$PLUGIN_ID"

    require_plugins_dir
    require_not_builtin "$PLUGIN_ID"

    # Workaround for .pyc files created by inkypi app with sudo
    if [[ -d "$DEST_DIR" ]]; then
        sudo chown -R "$(whoami)":"$(whoami)" "$DEST_DIR" 2>/dev/null || true
        chmod -R u+rw "$DEST_DIR" 2>/dev/null || true
    fi

    echo "[INFO] Installing plugin '$PLUGIN_ID' from $REPO_URL"

    remove_plugin_dir "$PLUGIN_ID"
    mkdir -p "$DEST_DIR"

    if ! git clone --depth 1 --filter=blob:none --sparse "$REPO_URL" "$DEST_DIR" &>/dev/null; then
        echo "[ERROR] Could not clone $REPO_URL"
        remove_plugin_dir "$PLUGIN_ID"
        exit 1
    fi

    # Check if the folder exists in the branch
    DEFAULT_BRANCH=$(git -C "$DEST_DIR" symbolic-ref --short HEAD 2>/dev/null || echo main)
    if ! git -C "$DEST_DIR" ls-tree --name-only "$DEFAULT_BRANCH" | grep -qx "$PLUGIN_ID"; then
        echo "[INFO] Plugin '$PLUGIN_ID' does not exist in the repo"
        remove_plugin_dir "$PLUGIN_ID"
        exit 1
    fi

    cd "$DEST_DIR"
    git sparse-checkout set "$PLUGIN_ID" &>/dev/null

    # Move plugin files to root of DEST_DIR
    shopt -s dotglob
    mv "$PLUGIN_ID"/* ./
    rm -rf "$PLUGIN_ID"

    echo "[INFO] Plugin copied to $DEST_DIR"

    # Install requirements if any
    REQ_FILE="$DEST_DIR/requirements.txt"

    if [[ -f "$REQ_FILE" ]]; then
        echo "[INFO] requirements.txt found, installing dependencies..."
        install_plugin_requirements "$PLUGIN_ID" "$REQ_FILE"
        echo "[INFO] Dependencies installed"
    else
        echo "[INFO] No requirements.txt found, skipping dependency install"
    fi

    echo "[INFO] Restarting $APPNAME service."
    sudo systemctl restart "$APPNAME.service"

    echo "[INFO] Done"
}

# ----------------------------
# REMOVE
# ----------------------------
uninstall_plugin() {
    if [[ $# -ne 1 ]]; then
        usage
        exit 1
    fi

    PLUGIN_ID="$1"
    require_valid_plugin_id "$PLUGIN_ID"
    DEST_DIR="$PLUGINS_DIR/$PLUGIN_ID"

    require_plugins_dir
    require_not_builtin "$PLUGIN_ID"

    if [[ ! -d "$DEST_DIR" ]]; then
        echo "[ERROR] Plugin '$PLUGIN_ID' is not installed."
        exit 1
    fi

    echo "[INFO] Removing plugin '$PLUGIN_ID'"

    sudo chown -R "$(whoami)":"$(whoami)" "$DEST_DIR" 2>/dev/null || true
    remove_plugin_dir "$PLUGIN_ID"

    echo "[INFO] Plugin successfully uninstalled"

    echo "[INFO] Restarting $APPNAME service."
    sudo systemctl restart "$APPNAME.service"
}

# ----------------------------
# LIST
# ----------------------------
list_plugins() {
    require_plugins_dir
    {
        printf "PLUGIN\tNAME\tTYPE\tREPOSITORY\n"

        for plugin_dir in "$PLUGINS_DIR"/*; do
            plugin_id="$(basename "$plugin_dir")"
            [[ "$plugin_id" == "base_plugin" ]] && continue

            info_file="$plugin_dir/plugin-info.json"
            [[ ! -f "$info_file" ]] && continue

            # Extract name + repository
            IFS=$'\t' read -r name repo < <(
                jq -r '[.display_name, .repository] | map(. // "") | @tsv' "$info_file"
            )

            # Infer type from repository presence
            if [[ -n "$repo" ]]; then
                type="third_party"
            else
                type="builtin"
                repo="-"
            fi

            printf "%s\t%s\t%s\t%s\n" \
                "$plugin_id" "$name" "$type" "$repo"
        done
    } | column -t -s $'\t'
}
# ----------------------------
# COMMAND ROUTER
# ----------------------------

case "$command" in
    install)
        install_plugin "$@"
        ;;
    uninstall)
        uninstall_plugin "$@"
        ;;
    list)
        list_plugins
        ;;
    ""|-h|--help|help)
        usage
        ;;
    *)
        echo "[ERROR] Unknown command: $command"
        usage
        exit 1
        ;;
esac
