{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": {
    "python": "3.13",
    "ninja":  "latest",
    "github:NixOS/nixpkgs/b4fd65b198c599cbe814fcb9f42d25d021595ec9#chromium": { // Chromium 154.0.8037.57 stable; pinned Nixpkgs source and hashes.
      "platforms": ["aarch64-linux", "x86_64-linux"], // Chromium is unstable on MacOS, use system's Google Chrome there.
    },
    "git": { // Devbox on MacOS cannot find system git
      "version":   "latest",
      "platforms": ["aarch64-darwin", "x86_64-darwin"],
    },
  },
  "shell": {
    "init_hook": [
      "bash scripts/devbox_init.sh",
      ". .venv/bin/activate",
      "export PYTHONPATH=\"${DEVBOX_PROJECT_ROOT}:${DEVBOX_PROJECT_ROOT}/src${PYTHONPATH:+:$PYTHONPATH}\"",
    ],
    "scripts": {
      "verify-browser": "bash scripts/devbox_verify_browser.sh",
      "dev": [
        "python src/inkypi.py --dev",
      ],
      "test": [
        "pytest",
      ],
    },
  },
}
