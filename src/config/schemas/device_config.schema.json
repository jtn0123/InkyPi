{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkypi.dev/schemas/device_config.schema.json",
  "title": "InkyPi Device Configuration",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "description": "Tabs are allowed; other control characters are not. A longer name saved before the limit existed is cut to maxLength when the config loads.",
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\u007f-\\u009f]*$"
    },
    "time_format": { "type": "string", "enum": ["12h", "24h"] },
    "log_system_stats": {
      "description": "Only a default: readers treat any value as true or false. Safe reset restores the default.",
      "default": false
    },
    "isolated_plugins": {
      "description": "Only a default: the isolation routes treat a non-list as empty. Safe reset restores the default.",
      "default": []
    },
    "display_type": {
      "type": "string",
      "anyOf": [
        { "enum": ["mock", "inky"] },
        { "pattern": "^epd[A-Za-z0-9_]*in[A-Za-z0-9_]*$" }
      ]
    },
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer" }
    },
    "orientation": { "type": "string", "enum": ["horizontal", "vertical"] },
    "plugin_cycle_interval_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400,
      "default": 3600
    },
    "preview_size_mode": { "type": "string", "enum": ["native", "scaled", "fit"] },
    "image_settings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "saturation": { "type": "number", "minimum": 0, "maximum": 10 },
        "brightness": { "type": "number", "minimum": 0, "maximum": 10 },
        "sharpness": { "type": "number", "minimum": 0, "maximum": 10 },
        "contrast": { "type": "number", "minimum": 0, "maximum": 10 },
        "inky_saturation": { "type": "number", "minimum": 0, "maximum": 10 },
        "screen_rendering": { "type": "string", "enum": ["auto", "dithered"] }
      }
    },
    "history_cleanup": {
      "type": "object",
      "description": "How much display history to keep. 0 turns a limit off.",
      "additionalProperties": true,
      "properties": {
        "max_age_days": { "type": "integer", "minimum": 0 },
        "max_count": { "type": "integer", "minimum": 0 },
        "min_free_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "playlist_config": {
      "type": "object",
      "properties": {
        "playlists": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "plugins"],
            "properties": {
              "name": { "type": "string" },
              "start_time": {
                "type": "string",
                "description": "HH:MM from 00:00 to 23:59, or 24:00 for midnight at the end of the day. utils.time_utils.parse_hhmm reads times by this rule.",
                "minLength": 5,
                "maxLength": 5,
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$|^24:00$"
              },
              "end_time": {
                "type": "string",
                "description": "Same rule as start_time.",
                "minLength": 5,
                "maxLength": 5,
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$|^24:00$"
              },
              "plugins": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["plugin_id", "plugin_settings"],
                  "properties": {
                    "plugin_id": { "type": "string" },
                    "name": { "type": "string" },
                    "plugin_settings": { "type": "object" },
                    "refresh": {
                      "type": "object",
                      "properties": {
                        "interval": { "type": "integer", "minimum": 1 },
                        "schedule": { "type": "string" }
                      }
                    },
                    "latest_refresh_time": { "type": ["string", "null"] }
                  }
                }
              },
              "current_plugin_index": { "type": ["integer", "null"] }
            }
          }
        },
        "active_playlist": { "type": ["string", "null"] }
      }
    },
    "refresh_info": { "type": "object" },
    "skipped_playlists": {
      "type": "array",
      "description": "Playlists the loader set aside because they broke the playlist rules above, each as {reason, playlist}. They are not shown or scheduled; fix one by hand and move it back into playlist_config.playlists."
    }
  }
}
